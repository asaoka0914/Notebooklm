# AI Agent 與 IDE 本地設定 (嚴禁提交 GitHub)
.gemini/
.claude/
.vscode/
.idea/
*.code-workspace

# 系統與雲端同步暫存檔
desktop.ini
.DS_Store
Thumbs.db
*.tmp
~$*

# 敏感資訊與密鑰檔 (API Keys, Cookies, Credentials)
.env
.env.*
*.key
*.pem
credentials.json
client_secret*.json
*.cookie
profiles/
config/auth*.yaml

# 書籍原始檔案與擷取產出資料 (書籍檔、圖片與生成報告)
*.epub
*.pdf
*.mobi
*.azw3
raw_outputs/
final/
config/book_config.yaml
config/book_toc.json
notebooklm_pipeline_spec_v2.md

# Python 快取與測試暫存檔
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# 執行暫存與狀態檔
scratch/
qc_status.json

# 排查診斷與測試暫存（保留 changelog_index.json）
check/*
!check/changelog_index.json

# 封存舊檔案目錄
old data/

# 壓縮包與依賴檔
*.zip
*.tar.gz
node_modules/

# Auth Pool Token（一次性 Session Token，本機暫存，不推送）
auth_pool/tokens/
auth_pool/pool_status.json

